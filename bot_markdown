import streamlit as st
import openai

# API Key
openai.api_key = "" 

# Page configuration
st.set_page_config(
    page_title="Dumb Chatbot",
    page_icon="💬",
    layout="centered"
)

# Sidebar
with st.sidebar:
    st.header("📔 My details")
    st.write("I use: GPT-4o")
    st.write("API: OpenRouter")
    st.write("Made by: kiyaaaa")

# Page title
st.title("🤖 Streamlit ChatBot")

# User Input
user_input = st.chat_input("How may I help you kiyaaa....")

if user_input:
    # Display user message
    st.chat_message("user").write(user_input)

    # AI response
    with st.chat_message("assistant"):
        response_box = st.empty()
        response_text = ""
        stream = openai.chat.completions.create(
            model="gpt-4o",
            messages=[{"role": "user", "content": user_input}],
            stream=True
        )

        for word in stream:
            content = word.choices[0].delta.content or ""
            response_text += content
            response_box.markdown(response_text)  
